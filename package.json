{
  "name": "emberai",
  "version": "0.1.0",
  "private": true,
  "description": "EmberAI storytelling platform monorepo",
  "packageManager": "pnpm@10.28.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run check:integrity && pnpm -r --if-present run typecheck && pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "clean": "rm -rf apps/*/dist packages/*/dist",
    "check:integrity": "node scripts/check-repository-integrity.mjs"
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check:conflicts && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "node --test packages/*/dist/test/*.test.js apps/*/dist/test/*.test.js",
    "clean": "rm -rf apps/*/dist packages/*/dist",
    "check:conflicts": "node scripts/check-no-conflict-markers.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
  "workspaces": ["apps/api", "apps/web", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "node --test packages/*/dist/test/*.test.js apps/*/dist/test/*.test.js",
    "clean": "rm -rf apps/*/dist packages/*/dist"
  },
  "devDependencies": {"typescript": "^5.7.3"}
}
